{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist-types",
    "rootDir": "src"
  },
  "include": ["src/index.ts", "src/components/**/*.ts", "src/components/**/*.tsx", "src/lib/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**", "src/demo/**"]
}
