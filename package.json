{
  "name": "@hp-future/skill-editor",
  "version": "0.1.0",
  "description": "React 组件：载入 .zip 技能包并展示其目录树",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hp-future/skill-editor.git"
  },
  "homepage": "https://hp-future.github.io/skill-editor/",
  "bugs": {
    "url": "https://github.com/hp-future/skill-editor/issues"
  },
  "main": "./dist/skill-editor.js",
  "module": "./dist/skill-editor.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/skill-editor.js"
    },
    "./style.css": "./dist/skill-editor.css"
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --project tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "node --experimental-strip-types scripts/inspect-zip.mts",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "keywords": [
    "react",
    "react-component",
    "zip",
    "zip-archive",
    "skill",
    "skill-package",
    "file-tree",
    "markdown",
    "preview",
    "editor"
  ],
  "author": "hp-future",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
