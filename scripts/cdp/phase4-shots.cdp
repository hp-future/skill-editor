{"label":"nothing selected","expression":"(() => ({ preview: !!document.querySelector('.se-preview'), rows: document.querySelectorAll('[role=treeitem]').length }))()"}
{"label":"capture phase 1 look","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase1.png"}
{"label":"collapse all and select SKILL.md","expression":"(async () => { document.querySelector('.se-panel__header .se-icon-button').dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 250)); const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); return { rows: document.querySelectorAll('[role=treeitem]').length, heading: document.querySelector('.se-md__heading')?.textContent }; })()"}
{"label":"capture phase 3 collapsed","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase3-collapsed.png"}
