{"label":"select SKILL.md","expression":"(async () => { const rows = [...document.querySelectorAll('[role=treeitem]')]; const row = rows.find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); return { ok: !!document.querySelector('.se-md') }; })()"}
{"label":"screenshot rendered preview","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase2-selected.png"}
{"label":"select task-mapping.md","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'references/task-mapping.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); document.querySelector('.se-preview__scroll').scrollTop = 260; return { tables: document.querySelectorAll('.se-md__table').length }; })()"}
{"label":"screenshot markdown table","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase2-table.png"}
{"label":"switch to source view","expression":"(async () => { [...document.querySelectorAll('.se-toggle__button')].find(b => b.textContent.includes('源码')).click(); await new Promise(r => setTimeout(r, 300)); return { sourceChars: document.querySelector('.se-preview__source')?.textContent.length }; })()"}
{"label":"select openai.yaml","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'agents/openai.yaml'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 300)); return { name: document.querySelector('.se-preview__name')?.textContent }; })()"}
{"label":"screenshot source view","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase2-source.png"}
