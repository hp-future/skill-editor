{"label":"select SKILL.md","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 350)); return { heading: document.querySelector('.se-md__heading')?.textContent, hasEmptyPlaceholder: !!document.querySelector('.se-detail-placeholder') }; })()"}
{"label":"scroll then switch view","expression":"(async () => { const pane = document.querySelector('.se-preview__scroll'); pane.scrollTop = 400; await new Promise(r => setTimeout(r, 100)); const scrolled = pane.scrollTop; [...document.querySelectorAll('.se-toggle__button')].find(b => b.textContent.includes('源码')).click(); await new Promise(r => setTimeout(r, 250)); const afterSource = document.querySelector('.se-preview__scroll')?.scrollTop; [...document.querySelectorAll('.se-toggle__button')].find(b => b.textContent.includes('预览')).click(); await new Promise(r => setTimeout(r, 300)); return { scrolled, afterSource, afterBackToRendered: document.querySelector('.se-preview__scroll')?.scrollTop }; })()"}
{"label":"scroll then change file resets","expression":"(async () => { const pane = document.querySelector('.se-preview__scroll'); pane.scrollTop = 300; await new Promise(r => setTimeout(r, 80)); const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'references/field-dictionary.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 350)); return { name: document.querySelector('.se-preview__name')?.textContent, scrollTop: document.querySelector('.se-preview__scroll')?.scrollTop }; })()"}
{"label":"keyboard Enter selects and previews","expression":"(async () => { const rows = [...document.querySelectorAll('[role=treeitem]')]; rows[0].focus(); const send = k => document.activeElement.dispatchEvent(new KeyboardEvent('keydown', { key: k, bubbles: true, cancelable: true })); send('ArrowDown'); const focused = document.activeElement.dataset.path; const beforeEnter = document.querySelector('.se-preview__name')?.textContent; send('Enter'); await new Promise(r => setTimeout(r, 350)); return { focused, beforeEnter, previewName: document.querySelector('.se-preview__name')?.textContent }; })()"}
{"label":"copy button feedback","expression":"(async () => { const button = [...document.querySelectorAll('.se-preview__actions button')].find(b => (b.getAttribute('aria-label') || '').startsWith('复制')); button.click(); await new Promise(r => setTimeout(r, 250)); return { labels: [...document.querySelectorAll('.se-preview__actions button')].map(b => b.getAttribute('aria-label')) }; })()"}
