{"label":"keyboard navigation","expression":"(() => { const rows = [...document.querySelectorAll('[role=treeitem]')]; const paths = rows.map(r => r.dataset.path); rows[0].focus(); const send = k => document.activeElement.dispatchEvent(new KeyboardEvent('keydown', { key: k, bubbles: true, cancelable: true })); send('ArrowDown'); const one = document.activeElement.dataset.path; send('ArrowRight'); const refRow = document.querySelector('[role=treeitem][data-path=references]'); const expandedAfterRight = refRow.getAttribute('aria-expanded'); const visibleAfterRight = document.querySelectorAll('[role=treeitem]').length; send('ArrowLeft'); return { paths, afterArrowDown: one, expandedAfterRight, visibleAfterRight, afterArrowLeft: document.activeElement.dataset.path }; })()"}
{"label":"click selection","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'references/api-index.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 60)); return { selectedRows: document.querySelectorAll('.se-tree__content.is-selected').length, ariaSelected: row.getAttribute('aria-selected'), selectedInFooter: [...document.querySelectorAll('.demo__meta-item--wide .demo__meta-value')].map(n => n.textContent) }; })()"}
{"label":"drag and drop a zip","expression":"(async () => { const res = await fetch('/src/demo/sample/api-call-by-knowledge.zip'); const blob = await res.blob(); const dt = new DataTransfer(); dt.items.add(new File([blob], 'dropped-skill.zip', { type: 'application/zip' })); const root = document.querySelector('.se-root'); const probe = { dtTypes: [...dt.types], files: dt.files.length, hasFiles: dt.types.includes('Files') }; const overEvent = new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer: dt }); const notCancelled = root.dispatchEvent(overEvent); await new Promise(r => setTimeout(r, 80)); const dragging = root.classList.contains('se-root--dragging'); const hint = !!document.querySelector('.se-drop-hint'); root.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: dt })); await new Promise(r => setTimeout(r, 900)); return { probe, notCancelled, dragging, hint, subtitle: document.querySelector('.se-toolbar__subtitle').textContent, stats: document.querySelector('.se-panel__stats').textContent, rows: document.querySelectorAll('[role=treeitem]').length, stillDragging: root.classList.contains('se-root--dragging') }; })()"}
{"label":"file picker accepted type","expression":"(() => { const input = document.querySelector('.se-visually-hidden[type=file]'); const label = document.querySelector('label[for=' + JSON.stringify(input.id) + ']'); return { accept: input.accept, hasLabel: !!label, labelText: label?.textContent }; })()"}
{"label":"clear button","expression":"(async () => { document.querySelector('.se-button--ghost').click(); await new Promise(r => setTimeout(r, 80)); return { emptyText: document.querySelector('.se-empty p')?.textContent ?? null, hasTree: !!document.querySelector('[role=tree]'), footer: document.querySelector('.se-panel__footer')?.textContent ?? null }; })()"}
