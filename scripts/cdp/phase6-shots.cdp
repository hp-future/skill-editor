{"label":"open editor on SKILL.md","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); const edit = [...document.querySelectorAll('.se-preview__actions button')].find(b => b.textContent === '编辑'); edit.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 300)); return { hasEditor: !!document.querySelector('.se-editor__textarea') }; })()"}
{"label":"capture editor","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase6-editor.png"}
{"label":"save an edit so the dirty markers show","expression":"(async () => { const textarea = document.querySelector('.se-editor__textarea'); const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set; setter.call(textarea, textarea.value.replace('# API 知识库调用规划', '# API 知识库调用规划（已编辑）')); textarea.dispatchEvent(new Event('input', { bubbles: true })); await new Promise(r => setTimeout(r, 150)); const save = [...document.querySelectorAll('.se-editor__actions button')].find(b => b.textContent.includes('保存')); save.dispatchEvent(new MouseEvent('click', { bubbles: true })); const exit = [...document.querySelectorAll('.se-editor__actions button')].find(b => b.getAttribute('aria-label') === '完成并退出编辑'); exit.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); return { detail: document.querySelector('.demo__toolbar-subtitle')?.textContent, dots: document.querySelectorAll('.se-tree__dirty').length }; })()"}
{"label":"capture dirty state","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase6-dirty.png"}
{"label":"open the export confirmation","expression":"(async () => { document.querySelector('[data-testid=demo-export]').dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); return { hasDialog: !!document.querySelector('dialog') }; })()"}
{"label":"capture dialog","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase6-dialog.png"}
