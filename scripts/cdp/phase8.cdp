{"label":"load, open, and follow the anchor link","expression":"(async () => { const base64 = ''; const deadline = Date.now() + 10000; let input = null; while (Date.now() < deadline) { input = document.getElementById('demo-zip-input'); if (input) break; await new Promise(r => setTimeout(r, 100)); } const binary = atob(base64); const bytes = new Uint8Array(binary.length); for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i); const transfer = new DataTransfer(); transfer.items.add(new File([bytes], 'link-demo.zip', { type: 'application/zip' })); Object.defineProperty(input, 'files', { configurable: true, value: transfer.files }); input.dispatchEvent(new Event('change', { bubbles: true })); await new Promise(r => setTimeout(r, 1500)); const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 800)); return { links: [...document.querySelectorAll('.se-md__link')].length }; })()"}
{"label":"capture the link document","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase8-links.png"}
{"label":"follow the link with an anchor","expression":"(async () => { const link = [...document.querySelectorAll('.se-md__link')].find(a => a.getAttribute('data-md-link') === 'references/api-index.md#检索命令'); link.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })); await new Promise(r => setTimeout(r, 1000)); const active = document.querySelector('.se-md__heading.is-active'); return { previewName: document.querySelector('.se-preview__name')?.textContent ?? null, activeId: active?.id ?? null, headings: [...document.querySelectorAll('.se-md__heading')].map(h => h.id), scrolled: Math.round(document.querySelector('.se-preview__scroll').scrollTop) }; })()"}
{"label":"capture the jumped anchor","waitMs":200,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase8-anchor.png"}
{"label":"broken link notice","expression":"(async () => { const back = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); back.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 700)); const link = [...document.querySelectorAll('.se-md__link')].find(a => a.getAttribute('data-md-link') === 'references/missing.md'); link.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })); await new Promise(r => setTimeout(r, 400)); return { notice: document.querySelector('.se-preview__link-notice')?.textContent ?? null, stillOn: document.querySelector('.se-preview__name')?.textContent ?? null }; })()"}
{"label":"capture the broken-link notice","waitMs":200,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase8-broken.png"}
{"label":"same-document anchor","expression":"(async () => { const link = [...document.querySelectorAll('.se-md__link')].find(a => a.getAttribute('data-md-link') === '#结尾'); link.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })); await new Promise(r => setTimeout(r, 700)); const active = document.querySelector('.se-md__heading.is-active'); return { path: location.pathname, activeId: active?.id ?? null, previewName: document.querySelector('.se-preview__name')?.textContent ?? null }; })()"}
