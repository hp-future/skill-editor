{"label":"load the demo package through the host picker","expression":"(async () => { const base64 = '__BASE64__'; const deadline = Date.now() + 10000; let input = null; while (Date.now() < deadline) { input = document.getElementById('demo-zip-input'); if (input) break; await new Promise(r => setTimeout(r, 100)); } const binary = atob(base64); const bytes = new Uint8Array(binary.length); for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i); const transfer = new DataTransfer(); transfer.items.add(new File([bytes], 'link-demo.zip', { type: 'application/zip' })); Object.defineProperty(input, 'files', { configurable: true, value: transfer.files }); input.dispatchEvent(new Event('change', { bubbles: true })); await new Promise(r => setTimeout(r, 1200)); return { rowCount: document.querySelectorAll('[role=treeitem]').length }; })()"}
{"label":"highlight the shell script","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'scripts/build.sh'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 600)); const pre = document.querySelector('.se-preview__source'); const spans = [...(pre?.querySelectorAll('code span') ?? [])]; const byClass = {}; for (const s of spans) { const key = s.className.replace('se-code__', ''); byClass[key] = (byClass[key] ?? 0) + 1; } return { language: pre?.getAttribute('data-language'), tokenCount: spans.length, byClass, colors: [...new Set(spans.map(s => getComputedStyle(s).color))], text: spans.slice(0, 3).map(s => s.className.replace('se-code__', '') + ':' + s.textContent) }; })()"}
{"label":"capture the shell highlight","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase9-sh.png"}
{"label":"highlight the TypeScript file","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'scripts/tool.ts'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 600)); const pre = document.querySelector('.se-preview__source'); const spans = [...(pre?.querySelectorAll('code span') ?? [])]; const byClass = {}; for (const s of spans) { const key = s.className.replace('se-code__', ''); byClass[key] = (byClass[key] ?? 0) + 1; } return { language: pre?.getAttribute('data-language'), tokenCount: spans.length, byClass, colors: [...new Set(spans.map(s => getComputedStyle(s).color))], sample: spans.slice(0, 5).map(s => s.className.replace('se-code__', '') + ':' + s.textContent) }; })()"}
{"label":"capture the ts highlight","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase9-ts.png"}
{"label":"plain text stays uncoloured","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'agents/openai.yaml'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 500)); const pre = document.querySelector('.se-preview__source'); return { language: pre?.getAttribute('data-language') ?? null, spanCount: pre?.querySelectorAll('code span').length ?? -1, text: pre?.textContent?.slice(0, 30) }; })()"}
