{"label":"tree panel footer gone","expression":"(() => ({ footer: !!document.querySelector('.se-panel__footer'), badge: !!document.querySelector('.se-badge'), treePanelText: document.querySelector('.se-panel--tree')?.textContent }))()"}
{"label":"select SKILL.md","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); return { heading: document.querySelector('.se-md__heading')?.textContent, subtitle: document.querySelector('.se-toolbar__subtitle')?.textContent }; })()"}
{"label":"capture","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase2-selected.png"}
