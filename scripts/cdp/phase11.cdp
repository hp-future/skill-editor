{"label":"inspect the default split","expression":"(async () => { const deadline = Date.now() + 20000; let handle = null; let ready = false; while (Date.now() < deadline) { handle = document.querySelector('.se-splitter'); ready = document.querySelector('[data-testid=se-tree]')?.getAttribute('data-state') === 'ready'; if (handle && ready) break; await new Promise(r => setTimeout(r, 150)); } if (!handle) return { error: 'no splitter' }; const body = handle.parentElement; const tree = document.querySelector('.se-panel--tree'); return { ready, title: document.querySelector('.demo__toolbar-title')?.textContent ?? null, splitter: !!handle, columns: getComputedStyle(body).gridTemplateColumns, treeWidth: Math.round(tree.getBoundingClientRect().width), detailWidth: Math.round(document.querySelector('.se-panel--detail').getBoundingClientRect().width), ariaNow: handle.getAttribute('aria-valuenow'), cursor: getComputedStyle(handle).cursor }; })()"}
{"label":"capture the default split","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase11-default.png"}
{"label":"drag the splitter 140px to the right","expression":"(async () => { const handle = document.querySelector('.se-splitter'); const tree = document.querySelector('.se-panel--tree'); const before = Math.round(tree.getBoundingClientRect().width); const startX = Math.round(handle.getBoundingClientRect().left); const y = Math.round(handle.getBoundingClientRect().top + 80); const fire = (type, x) => handle.dispatchEvent(new PointerEvent(type, { bubbles: true, cancelable: true, button: 0, buttons: 1, clientX: x, clientY: y, pointerId: 1, pointerType: 'mouse' })); fire('pointerdown', startX); fire('pointermove', startX + 70); fire('pointermove', startX + 140); fire('pointerup', startX + 140); await new Promise(r => setTimeout(r, 300)); return { before, after: Math.round(tree.getBoundingClientRect().width), columns: getComputedStyle(handle.parentElement).gridTemplateColumns, ariaNow: handle.getAttribute('aria-valuenow'), separatorActive: handle.classList.contains('is-active') }; })()"}
{"label":"capture after drag","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase11-dragged.png"}
{"label":"clamp at the extremes and reset by keyboard","expression":"(async () => { const handle = document.querySelector('.se-splitter'); const tree = document.querySelector('.se-panel--tree'); const key = (k) => handle.dispatchEvent(new KeyboardEvent('keydown', { key: k, bubbles: true, cancelable: true })); key('Home'); await new Promise(r => setTimeout(r, 100)); const min = Math.round(tree.getBoundingClientRect().width); key('End'); await new Promise(r => setTimeout(r, 100)); const max = Math.round(tree.getBoundingClientRect().width); const total = Math.round(handle.parentElement.getBoundingClientRect().width); key('Enter'); await new Promise(r => setTimeout(r, 100)); return { min, max, total, reset: Math.round(tree.getBoundingClientRect().width), detailAtMax: Math.round(document.querySelector('.se-panel--detail').getBoundingClientRect().width) }; })()"}
{"label":"narrow container stacks the panes","expression":"(async () => { const root = document.querySelector('.se-root'); root.style.width = '520px'; await new Promise(r => setTimeout(r, 400)); const handle = document.querySelector('.se-splitter'); const body = handle.parentElement; return { splitterDisplay: getComputedStyle(handle).display, columns: getComputedStyle(body).gridTemplateColumns, treeWidth: Math.round(document.querySelector('.se-panel--tree').getBoundingClientRect().width) }; })()"}
