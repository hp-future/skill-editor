{"label":"select the markdown file","expression":"(async () => { const deadline = Date.now() + 10000; let row; while (Date.now() < deadline) { row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); if (row) break; await new Promise(r => setTimeout(r, 100)); } if (!row) return { error: 'row missing' }; row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 700)); return { headings: document.querySelectorAll('.se-md__heading').length, pres: document.querySelectorAll('.se-md__pre').length, kind: document.querySelector('.se-preview__kind')?.textContent ?? null, actions: [...document.querySelectorAll('.se-preview__actions button')].map(b => b.getAttribute('aria-label') ?? b.textContent) }; })()"}
{"label":"scroll to a highlighted code block","expression":"(async () => { const pre = [...document.querySelectorAll('.se-md__pre')].find(p => p.getAttribute('data-language') === 'json'); const scroller = document.querySelector('.se-preview__scroll'); if (!pre || !scroller) return { error: 'no json block' }; scroller.scrollTop = pre.offsetTop - scroller.offsetTop - 12; await new Promise(r => setTimeout(r, 300)); return { language: pre.getAttribute('data-language'), scrollTop: Math.round(scroller.scrollTop) }; })()"}
{"label":"capture code highlight","waitMs":250,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase7-code.png"}
{"label":"open the table of contents","expression":"(async () => { const button = [...document.querySelectorAll('.se-preview__actions button')].find(b => b.getAttribute('aria-label') === '目录'); if (!button) return { error: 'no toc button' }; button.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 250)); const panel = document.querySelector('.se-toc__panel'); return { hasPanel: !!panel, items: [...(panel?.querySelectorAll('.se-toc__item') ?? [])].map(i => i.textContent), expanded: button.getAttribute('aria-expanded') }; })()"}
{"label":"capture toc","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase7-toc.png"}
{"label":"jump to the last heading","expression":"(async () => { const items = [...document.querySelectorAll('.se-toc__item')]; const target = items[items.length - 1]; const label = target?.textContent; target?.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 600)); const active = document.querySelector('.se-md__heading.is-active'); return { jumpedTo: label, activeId: active?.id ?? null, flashColor: active ? getComputedStyle(active).backgroundColor : null, panelClosed: !document.querySelector('.se-toc__panel'), scrollTop: Math.round(document.querySelector('.se-preview__scroll')?.scrollTop ?? -1) }; })()"}
{"label":"capture highlight","waitMs":200,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase7-highlight.png"}
