{"label":"load image archive through the file input","expression":"(async () => { const base64 = '__BASE64__'; const binary = atob(base64); const bytes = new Uint8Array(binary.length); for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i); const file = new File([bytes], 'image-demo.zip', { type: 'application/zip' }); const input = document.querySelector('input[type=file]'); const transfer = new DataTransfer(); transfer.items.add(file); Object.defineProperty(input, 'files', { configurable: true, value: transfer.files }); input.dispatchEvent(new Event('change', { bubbles: true })); await new Promise(r => setTimeout(r, 700)); return { subtitle: document.querySelector('.se-toolbar__subtitle')?.textContent, rows: [...document.querySelectorAll('[role=treeitem]')].map(r => r.dataset.path), stats: document.querySelector('.se-panel__stats')?.textContent }; })()"}
{"label":"preview the image","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'assets/logo.png'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); const img = document.querySelector('.se-preview__image'); return { hasImage: !!img, src: img?.getAttribute('src')?.slice(0, 32), naturalWidth: img?.naturalWidth, kind: document.querySelector('.se-preview__kind')?.textContent, meta: document.querySelector('.se-preview__meta')?.textContent, hasMarkdownToggle: document.querySelectorAll('.se-toggle').length }; })()"}
{"label":"preview a text file in the same archive","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'notes/readme.txt'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 300)); return { source: document.querySelector('.se-preview__source')?.textContent, kind: document.querySelector('.se-preview__kind')?.textContent, hasImage: !!document.querySelector('.se-preview__image') }; })()"}
