{"label":"select SKILL.md","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 250)); const md = document.querySelector('.se-md'); return { hasMarkdown: !!md, headings: [...document.querySelectorAll('.se-md__heading')].slice(0, 4).map(h => h.textContent), frontmatterKeys: [...document.querySelectorAll('.se-md__frontmatter dt')].map(n => n.textContent), tables: document.querySelectorAll('.se-md__table').length, codeBlocks: document.querySelectorAll('.se-md__pre').length, lists: document.querySelectorAll('.se-md__list').length, headerName: document.querySelector('.se-preview__name')?.textContent, meta: document.querySelector('.se-preview__meta')?.textContent }; })()"}
{"label":"switch to source view","expression":"(async () => { const buttons = [...document.querySelectorAll('.se-toggle__button')]; buttons.find(b => b.textContent.includes('源码')).click(); await new Promise(r => setTimeout(r, 150)); return { hasMarkdown: !!document.querySelector('.se-md'), sourceChars: document.querySelector('.se-preview__source')?.textContent.length, firstLine: document.querySelector('.se-preview__source')?.textContent.split('\\n')[0] }; })()"}
{"label":"back to rendered view","expression":"(async () => { [...document.querySelectorAll('.se-toggle__button')].find(b => b.textContent.includes('预览')).click(); await new Promise(r => setTimeout(r, 150)); return { hasMarkdown: !!document.querySelector('.se-md'), headings: document.querySelectorAll('.se-md__heading').length }; })()"}
{"label":"select yaml file","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'agents/openai.yaml'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 250)); return { name: document.querySelector('.se-preview__name')?.textContent, source: document.querySelector('.se-preview__source')?.textContent, hasToggle: document.querySelectorAll('.se-toggle').length }; })()"}
{"label":"copy button feedback","expression":"(async () => { const button = document.querySelector('[aria-label=\"复制内容\"], [aria-label=\"已复制\"]'); button.click(); await new Promise(r => setTimeout(r, 200)); const after = document.querySelector('.se-preview__actions button'); return { ariaLabels: [...document.querySelectorAll('.se-preview__actions button')].map(b => b.getAttribute('aria-label')) }; })()"}
{"label":"select markdown reference","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'references/task-mapping.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 250)); return { name: document.querySelector('.se-preview__name')?.textContent, tables: document.querySelectorAll('.se-md__table').length, rows: document.querySelectorAll('.se-md__table tbody tr').length, headings: [...document.querySelectorAll('.se-md__heading')].map(h => h.textContent) }; })()"}
