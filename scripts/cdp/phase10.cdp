{"label":"toolbar check","expression":"(async () => { const deadline = Date.now() + 15000; let ready = false; while (Date.now() < deadline) { if (document.querySelector('#demo-zip-input')) { ready = true; break; } await new Promise(r => setTimeout(r, 100)); } if (!ready) return { error: 'demo not ready' }; return { buttons: [...document.querySelectorAll('.demo__button')].map(b => b.textContent.trim()), fontSampleButton: !!document.querySelector('[data-testid=demo-font-sample]') }; })()"}
{"label":"load a package with a ttf","expression":"(async () => { const base64 = ''; const binary = atob(base64); const bytes = new Uint8Array(binary.length); for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i); const input = document.getElementById('demo-zip-input'); const transfer = new DataTransfer(); transfer.items.add(new File([bytes], 'font-demo.zip', { type: 'application/zip' })); Object.defineProperty(input, 'files', { configurable: true, value: transfer.files }); input.dispatchEvent(new Event('change', { bubbles: true })); await new Promise(r => setTimeout(r, 1200)); const row = [...document.querySelectorAll('[role=treeitem]')].find(r => (r.dataset.path ?? '').includes('.ttf')); if (!row) return { error: 'no ttf row' }; row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 1200)); return { previewed: !!document.querySelector('[data-testid=demo-font-preview]'), buttons: [...document.querySelectorAll('.demo__button')].map(b => b.textContent.trim()) }; })()"}
{"label":"capture","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase10-font.png"}
