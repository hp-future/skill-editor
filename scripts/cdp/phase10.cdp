{"label":"load the standard sample","expression":"(async () => { const deadline = Date.now() + 15000; let button = null; while (Date.now() < deadline) { button = [...document.querySelectorAll('.demo__button')].find(b => b.textContent.includes('载入示例包')); if (button) break; await new Promise(r => setTimeout(r, 100)); } button.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 1500)); return { title: document.querySelector('.demo__toolbar-title')?.textContent ?? null, rows: document.querySelectorAll('[role=treeitem]').length }; })()"}
{"label":"open SKILL.md (renderer regression)","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 700)); return { headings: document.querySelectorAll('.se-md__heading').length, pres: document.querySelectorAll('.se-md__pre').length, customBody: !!document.querySelector('.se-preview__custom') }; })()"}
{"label":"switch to the font sample, then back to markdown","expression":"(async () => { document.querySelector('[data-testid=demo-font-sample]').dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 1500)); const ttf = [...document.querySelectorAll('[role=treeitem]')].find(r => (r.dataset.path ?? '').includes('.ttf')); ttf.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 1000)); const fontRendered = !!document.querySelector('[data-testid=demo-font-preview]'); const md = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); md.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 700)); return { fontRendered, afterSwitch: { headings: document.querySelectorAll('.se-md__heading').length, customBody: !!document.querySelector('.se-preview__custom'), fontBody: !!document.querySelector('[data-testid=demo-font-preview]') }, errs: window.__errs ?? null }; })()"}
{"label":"restore the font sample state","expression":"(async () => { document.querySelector('[data-testid=demo-font-sample]').dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 1500)); const ttf = [...document.querySelectorAll('[role=treeitem]')].find(r => (r.dataset.path ?? '').includes('.ttf')); ttf.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 1000)); return { fontRendered: !!document.querySelector('[data-testid=demo-font-preview]') }; })()"}
{"label":"screenshot","waitMs":300,"method":"Page.captureScreenshot","params":{"format":"png"},"screenshotPath":"docs/phase10-font.png"}
