{"label":"hook URL.createObjectURL to capture the exported blob","expression":"(() => { window.__capturedBlob = null; const original = URL.createObjectURL.bind(URL); URL.createObjectURL = (blob) => { window.__capturedBlob = blob; return original(blob); }; return { hooked: true }; })()"}
{"label":"open the editor for SKILL.md","expression":"(async () => { const row = [...document.querySelectorAll('[role=treeitem]')].find(r => r.dataset.path === 'SKILL.md'); row.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); const edit = [...document.querySelectorAll('.se-preview__actions button')].find(b => b.textContent === '编辑'); edit.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 250)); const textarea = document.querySelector('.se-editor__textarea'); return { hasEditor: !!textarea, firstLine: textarea?.value.split('\\n')[0], actions: [...document.querySelectorAll('.se-editor__actions button')].map(b => b.textContent || b.getAttribute('aria-label')) }; })()"}
{"label":"type an edit and save","expression":"(async () => { const textarea = document.querySelector('.se-editor__textarea'); const next = textarea.value.replace('# API 知识库调用规划', '# API 知识库调用规划（已编辑）'); const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set; setter.call(textarea, next); textarea.dispatchEvent(new Event('input', { bubbles: true })); await new Promise(r => setTimeout(r, 200)); const unsavedBadge = !!document.querySelector('.se-editor__badge'); const save = [...document.querySelectorAll('.se-editor__actions button')].find(b => b.textContent.includes('保存')); save.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 250)); return { unsavedBadgeBeforeSave: unsavedBadge, saveDisabledAfter: save.disabled, dirtyDots: document.querySelectorAll('.se-tree__dirty').length, subtitle: document.querySelector('.demo__toolbar-subtitle').textContent }; })()"}
{"label":"leave the editor and confirm the preview shows the edit","expression":"(async () => { const exit = [...document.querySelectorAll('.se-editor__actions button')].find(b => b.getAttribute('aria-label') === '完成并退出编辑'); exit.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 400)); return { heading: document.querySelector('.se-md__heading')?.textContent, badge: document.querySelector('.se-preview__badge')?.textContent }; })()"}
{"label":"export from the host toolbar","expression":"(async () => { document.querySelector('[data-testid=demo-export]').dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 300)); const dialog = document.querySelector('dialog'); const text = dialog?.textContent; [...(dialog?.querySelectorAll('button') ?? [])].find(b => b.textContent === '仍然导出')?.dispatchEvent(new MouseEvent('click', { bubbles: true })); await new Promise(r => setTimeout(r, 900)); return { dialogText: text, captured: window.__capturedBlob ? { type: window.__capturedBlob.type, size: window.__capturedBlob.size } : null, notice: [...document.querySelectorAll('.demo__meta-value')].map(n => n.textContent).find(t => t.includes('已导出')) ?? null }; })()"}
{"label":"read the exported archive as base64","saveTo":".tmp-export.b64","expression":"(async () => { const blob = window.__capturedBlob; if (!blob) return { error: 'no blob' }; const buffer = new Uint8Array(await blob.arrayBuffer()); let binary = ''; const chunk = 0x8000; for (let i = 0; i < buffer.length; i += chunk) { binary += String.fromCharCode.apply(null, buffer.subarray(i, i + chunk)); } return btoa(binary); })()"}
